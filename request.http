@serverUrl = http://localhost:9080
@servletApi = jakarta-ee-lab/api/servlet
@restApi = jakarta-ee-lab/api/rest
@testUserId = 99999999-9999-9999-9999-999999999999
@testPoliticalPartyId = 99999999-9999-9999-9999-999999999999
@testPoliticianId = 99999999-9999-9999-9999-999999999999

### Get all users
GET {{serverUrl}}/{{servletApi}}/users

### Get single user

GET {{serverUrl}}/{{servletApi}}/users/{{testUserId}}

### Create user

POST {{serverUrl}}/{{servletApi}}/users
Content-Type: application/json

{
  "username": "testUser",
  "birthDate": "2021-11-11",
  "role": "USER"
}

### Create/update user

PUT {{serverUrl}}/{{servletApi}}/users/{{testUserId}}
Content-Type: application/json

{
  "username": "newUser",
  "birthDate": "2020-01-01",
  "role": "USER"
}

### Delete user

DELETE {{serverUrl}}/{{servletApi}}/users/{{testUserId}}

### Get user image

GET {{serverUrl}}/{{servletApi}}/users/{{testUserId}}/image

### Create user image

POST {{serverUrl}}/{{servletApi}}/users/{{testUserId}}/image
Content-Type: image/jpeg

< ./user-image.jpg

### Update/create user image

PUT {{serverUrl}}/{{servletApi}}/users/{{testUserId}}/image
Content-Type: image/jpeg

< ./user-image1.jpg

### Delete user image

DELETE {{serverUrl}}/{{servletApi}}/users/{{testUserId}}/image

### Get all political parties

GET {{serverUrl}}/{{restApi}}/political-parties

### Get single political party

GET {{serverUrl}}/{{restApi}}/political-parties/{{testPoliticalPartyId}}

### Create political party

POST {{serverUrl}}/{{restApi}}/political-parties
Content-Type: application/json

{
  "name": "New Political Party",
  "foundationDate": "2000-01-01",
  "orientation": "CENTER"
}

### Update/create political party

PUT {{serverUrl}}/{{restApi}}/political-parties/{{testPoliticalPartyId}}
Content-Type: application/json

{
  "name": "Test Political Party",
  "foundationDate": "1999-11-11",
  "orientation": "CENTER"
}

### Delete political party

DELETE {{serverUrl}}/{{restApi}}/political-parties/{{testPoliticalPartyId}}

### Get all politicians

GET {{serverUrl}}/{{restApi}}/politicians

### Get single politician

GET {{serverUrl}}/{{restApi}}/politicians/d76eb6a9-c99e-4556-8704-4f09431bd351

### Create politician

POST {{serverUrl}}/{{restApi}}/politicians
Content-Type: application/json

{
  "name": "Imie",
  "surname": "Nazwisko",
  "birthDate": "1999-11-11",
  "constituency": 10,
  "politicalParty": {
    "id": "{{testPoliticalPartyId}}"
  }
}

### Update/create politician

POST {{serverUrl}}/{{restApi}}/politicians/
Content-Type: application/json

{
  "name": "Imie",
  "surname": "Nazwisko",
  "birthDate": "1999-11-11",
  "constituency": 10,
  "politicalParty": {
    "id": "{{testPoliticalPartyId}}"
  }
}

### Delete politician

DELETE {{serverUrl}}/{{restApi}}/politicians/d76eb6a9-c99e-4556-8704-4f09431bd351