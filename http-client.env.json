{
  "dev": {
    "baseUrl": "http://localhost:9080/jakarta-ee-lab/api/rest",
    "Security": {
      "Auth": {
        "jakarta-ee-lab-auth": {
          "Type": "OAuth2",
          "Grant Type": "Authorization Code",
          "PKCE": true,
          "Client ID": "jakarta-client",
          "Client Secret": "secret",
          "Redirect URL": "http://localhost:9080/callback",
          "Auth URL": "http://localhost:9000/oauth2/authorize",
          "Token URL": "http://localhost:9000/oauth2/token",
          "Scope": "openid profile",
          "Custom Query Parameters": {
            "prompt": "login"
          }
        }
      }
    }
  }
}